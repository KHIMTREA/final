{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Frontend: npm run dev",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev"
			],
			"isBackground": true
		},
		{
			"label": "Install frontend dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"install"
			],
			"isBackground": false
		}
	]
}